# ProcureMind Backend Environment Variables (Placeholder Example)
# Copy this file to .env and adjust values for local development.

# Application Environment (development, test, production)
ENVIRONMENT=development
APP_NAME=ProcureMind-API
API_V1_STR=/api/v1
DEBUG=true

# Strict CORS Allowed Origins (comma-separated list)
# Default allows local Next.js frontend
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Authoritative Database (PostgreSQL / Neon)
# Example local postgres or Neon connection string:
# postgresql://user:password@localhost:5432/procuremind_dev
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/procuremind_dev

# Document Storage Interface
# Options: "local" (for local filesystem dev) or "s3" (for hosted private bucket)
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./local_storage
MAX_UPLOAD_SIZE_BYTES=15728640
DOWNLOAD_URL_EXPIRES_SECONDS=300

# Secret key used for signing short-lived download tokens (required for download URLs)
STORAGE_SIGNING_SECRET=change-this-in-production-to-a-secure-random-secret

# Hosted Object Storage (Required only when STORAGE_BACKEND=s3)
S3_BUCKET_NAME=procuremind-private-docs
S3_REGION=us-east-1
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Optional Secondary Services (Optional; failure will not block core operations)
# FalkorDB secondary graph connection
FALKORDB_ENABLED=false
FALKORDB_HOST=localhost
FALKORDB_PORT=6379

# Vector DB secondary retrieval
CHROMA_ENABLED=false
CHROMA_HOST=localhost
CHROMA_PORT=8000

# PayPal Sandbox Configuration (Strictly Sandbox - Live is prohibited)
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=your-sandbox-client-id
PAYPAL_CLIENT_SECRET=your-sandbox-client-secret
PAYPAL_WEBHOOK_ID=your-sandbox-webhook-id

# Auditor Secret for Invoice Approvals (Minimum 16 characters, must be configured)
AUDITOR_API_KEY=replace-with-a-secure-random-auditor-secret-min16chars

# Phase 6: Grounded AI Investigation Configuration (Safe fallback when unconfigured)
LLM_PROVIDER=gemini
LLM_API_KEY=your-gemini-api-key
LLM_MODEL=gemini-3.8-flash
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=15

